# Copy to .env.local. Blank required keys intentionally enable LOCAL DEMO mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FUNCTIONS_REGION=us-central1
# Register your web app with Firebase App Check (reCAPTCHA Enterprise).
# Production PIN verification requires App Check. Public site key, not a secret.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Keep false on shared devices; true persists equipment records on disk.
VITE_FIREBASE_PERSIST_CACHE=false
